<!--
  Copyright (c) 2026 bentzn
  SPDX-License-Identifier: Apache-2.0
  Author Claude/bentzn

  The Canton ADMIN API client, spoken dynamically.

  It exists as its own module because of two rules that meet here. S-1 bars
  every module above the translation line from declaring gRPC, so the client
  cannot live in raposza-canton or in an app. And raposza-wire declares no
  TRANSPORT on purpose, so the channel cannot be built there either. A
  translation module that names one transport and one descriptor library is the
  only place both hold.

  No vendor jar and no codegen: the descriptor comes off the participant.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.raposza</groupId>
        <artifactId>raposza-platform</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>raposza-admin</artifactId>
    <name>raposza-admin</name>

    <dependencies>
        <dependency>
            <groupId>com.raposza</groupId>
            <artifactId>raposza-wire</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- THE TRANSPORT, named here and nowhere above. grpc-netty rather
             than the shaded build because bindings-java already resolves
             netty at this exact version, so nothing new is downloaded and
             there is one netty on the classpath rather than two. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <!-- Translation module: SDK types are permitted here by S-1. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

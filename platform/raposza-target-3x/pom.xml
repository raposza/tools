<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.raposza</groupId>
        <artifactId>raposza-platform</artifactId>
        <version>0.4.1</version>
    </parent>

    <artifactId>raposza-target-3x</artifactId>
    <name>raposza-target-3x</name>

    <dependencies>
        <dependency>
            <groupId>com.raposza</groupId>
            <artifactId>raposza-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.raposza</groupId>
            <artifactId>raposza-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.raposza</groupId>
            <artifactId>raposza-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.raposza</groupId>
            <artifactId>raposza-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.raposza</groupId>
            <artifactId>raposza-wire</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- THE TRANSPORT. No Canton jar and no bindings artifact: this client
             is built from descriptors the participant serves, which is what
             keeps the v1/v2 class collision out of the build entirely. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <!-- Translation module: SDK types are permitted here by S-1, so the
         boundary rule declared in the parent is skipped. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
